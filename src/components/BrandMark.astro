---
// The SwyftClear mark: a room in plan, with its doorway drawn the way an
// architect draws one — a gap in the wall, the door leaf, and its swing.
export interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path class="brand-mark__walls" d="M11 28 H4 V4 H28 V28 H19"></path>
  <path class="brand-mark__door" d="M11 28 V20 A8 8 0 0 1 19 28"></path>
</svg>
