---
import type { Faq } from '../data/faqs';

export interface Props {
  faqs: Faq[];
  heading?: string;
  id?: string;
}

const { faqs, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<section class="section section--border-top" id={id} aria-labelledby={`${id}-heading`}>
  <div class="container stack">
    <h2 id={`${id}-heading`}>{heading}</h2>
    <div class="faq-list">
      {
        faqs.map((faq, i) => (
          <details class="faq-item" name={`${id}-group`}>
            <summary id={`${id}-q-${i}`}>{faq.q}</summary>
            <div class="faq-item__body">
              <p>{faq.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
