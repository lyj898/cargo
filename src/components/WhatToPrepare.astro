---
import { whatToPrepare } from '../data/trust';
---

<section class="section section--border-top" aria-labelledby="prepare-heading">
  <div class="container stack">
    <div class="eyebrow">Before you start</div>
    <h2 id="prepare-heading">What to prepare</h2>
    <p class="lede">
      You don’t need everything below to start the guided enquiry — but having it on hand makes the
      assessment faster and more accurate.
    </p>
    <ol class="prepare-grid">
      {
        whatToPrepare.map((item, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <strong>{item.label}</strong>
              <br />
              <span class="text-muted">{item.help}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
