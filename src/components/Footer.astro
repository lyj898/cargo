---
import { site, whatsappLink, withBase } from '../config/site';
import { services } from '../data/services';
import { clusters } from '../data/clusters';
import { LAST_REVIEWED_DISPLAY } from '../config/content';

const year = new Date().getFullYear();

// Every cluster hub is linked sitewide. On a mostly-programmatic site this is
// what keeps the deeper pages within two clicks of any entry point.
const hubs = clusters.filter((c) => c.inNav);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h3>Swyft<span style="color: var(--color-accent);">Clear</span>.com</h3>
        <p class="text-muted" style="max-width: 28rem; font-size: var(--step--1);">
          Singapore specialist for special cargo and customs support. We help with unusual,
          time-sensitive, and documentation-heavy cargo jobs.
        </p>
      </div>

      <div class="footer-col">
        <h3>Services</h3>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={withBase(`/${s.slug}`)}>{s.shortLabel}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3>Reference</h3>
        <ul>
          {
            hubs.map((c) => (
              <li>
                <a href={withBase(`/${c.base}`)}>{c.label}</a>
              </li>
            ))
          }
          <li><a href={withBase('/sitemap')}>Site map</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href={withBase('/case-studies')}>Case studies</a></li>
          <li><a href={withBase('/about')}>About</a></li>
          <li><a href={withBase('/contact')}>Contact</a></li>
          <li><a href={withBase('/enquiry')}>Start an enquiry</a></li>
          <li><a href={whatsappLink()} rel="noopener" target="_blank">WhatsApp</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>
        Singapore-focused cargo and customs coordination — not a licensed Declaring Agent unless
        stated for a specific engagement. Reference pages last reviewed {LAST_REVIEWED_DISPLAY};
        always confirm current requirements with the relevant authority.
      </p>
    </div>
  </div>
</footer>
