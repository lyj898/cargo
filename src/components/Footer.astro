---
import BrandMark from './BrandMark.astro';
import SectionTag from './SectionTag.astro';
import { site, withBase } from '../config/site';
import { hubs } from '../data/hubs';
import { tools } from '../data/library';
import { LAST_REVIEWED_DISPLAY } from '../config/content';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <a href={withBase('/')} class="brand footer-brand" aria-label="SwyftClear, home">
          <BrandMark size={24} />
          <span class="brand__word">Swyft<span>Clear</span></span>
        </a>
        <p class="text-muted" style="max-width: 28rem; font-size: var(--step--1); margin-top: var(--space-3);">
          Singapore guides for clearing a property you’re responsible for: a home you’ve sold or let,
          a condo’s common areas, business premises at the end of a lease, or an inherited home.
        </p>
        {/* The family's one footer link (family rule, 5 Oct 2026). nofollow because
            it's for readers, not rankings; never noreferrer, so OurKampung's GA4
            still sees where the visit came from. */}
        <p class="footer-family">Part of <a href="https://ourkampung.com/" rel="nofollow">OurKampung</a></p>
      </div>

      <div class="footer-col">
        <h3>Guides</h3>
        <ul class="footer-tags">
          {
            hubs.map((h) => (
              <li>
                <SectionTag slug={h.slug} label={h.label} href={`/${h.slug}`} scoped />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3>Tools</h3>
        <ul>
          {
            tools.map((t) => (
              <li>
                <a href={withBase(t.href)}>{t.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3>About</h3>
        <ul>
          <li><a href={withBase('/about')}>Who publishes SwyftClear</a></li>
          <li><a href={withBase('/contact')}>Ask for a quote</a></li>
          <li><a href={withBase('/about#privacy-and-analytics')}>Privacy</a></li>
          <li><a href={withBase('/sitemap')}>Site map</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}</p>
      <p>
        SwyftClear is run by {site.team}. Guides last reviewed {LAST_REVIEWED_DISPLAY}. General
        information, not legal advice.
      </p>
    </div>
  </div>
</footer>
