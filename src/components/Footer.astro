---
import { site, withBase } from '../config/site';
import { hubs } from '../data/hubs';
import { tools } from '../data/library';
import { LAST_REVIEWED_DISPLAY } from '../config/content';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h3>Swyft<span style="color: var(--color-accent);">Clear</span></h3>
        <p class="text-muted" style="max-width: 28rem; font-size: var(--step--1);">
          Singapore guides for clearing a property you’re responsible for: a late relative’s home, a
          home you’ve sold or let, a condo’s common areas, or business premises at the end of a lease.
        </p>
      </div>

      <div class="footer-col">
        <h3>Guides</h3>
        <ul>
          {
            hubs.map((h) => (
              <li>
                <a href={withBase(`/${h.slug}`)}>{h.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3>Tools</h3>
        <ul>
          {
            tools.map((t) => (
              <li>
                <a href={withBase(t.href)}>{t.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3>About</h3>
        <ul>
          <li><a href={withBase('/about')}>Who publishes SwyftClear</a></li>
          <li><a href={withBase('/sitemap')}>Site map</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.publisher.legalName}</p>
      <p>
        SwyftClear is published by {site.publisher.legalName}, the company behind
        {site.publisher.brand}. Guides last reviewed {LAST_REVIEWED_DISPLAY}. General information,
        not legal advice.
      </p>
    </div>
  </div>
</footer>
