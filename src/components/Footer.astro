---
import { site, whatsappLink } from '../config/site';
import { services } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h3>Cargo<span style="color: var(--color-accent);">Advisor</span>.sg</h3>
        <p class="text-muted" style="max-width: 28rem; font-size: var(--step--1);">
          Singapore specialist for special cargo and customs support. We help with unusual,
          time-sensitive, and documentation-heavy cargo jobs.
        </p>
      </div>

      <div class="footer-col">
        <h3>Services</h3>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/${s.slug}`}>{s.shortLabel}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href="/case-studies">Case studies</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/enquiry">Start an enquiry</a></li>
          <li><a href={whatsappLink()} rel="noopener" target="_blank">WhatsApp</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Singapore-focused cargo and customs coordination — not a licensed Declaring Agent unless stated for a specific engagement.</p>
    </div>
  </div>
</footer>
