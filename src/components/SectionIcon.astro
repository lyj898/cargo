---
// One line icon per section, drawn on a 24-unit grid with the same stroke so
// they read as a set: the home, its key, the block it sits in, the office.
export interface Props {
  slug: string;
  size?: number;
}

const { slug, size = 20 } = Astro.props;
---

<svg
  class="section-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {
    slug === 'estates' && (
      <>
        <path d="M4 11 L12 4 L20 11 V20 H4 Z"></path>
        <path d="M10 20 V14 H14 V20"></path>
      </>
    )
  }
  {
    slug === 'handover' && (
      <>
        <circle cx="8" cy="12" r="4"></circle>
        <path d="M12 12 H21 M18 12 V15 M21 12 V16"></path>
      </>
    )
  }
  {
    slug === 'buildings' && (
      <>
        <rect x="6" y="3" width="12" height="18" rx="1"></rect>
        <path d="M9 7 H10 M14 7 H15 M9 11 H10 M14 11 H15 M9 15 H10 M14 15 H15 M11 21 V18 H13 V21"></path>
      </>
    )
  }
  {
    slug === 'business' && (
      <>
        <rect x="3" y="8" width="18" height="12" rx="2"></rect>
        <path d="M9 8 V6 a1 1 0 0 1 1 -1 H14 a1 1 0 0 1 1 1 V8 M3 13 H21"></path>
      </>
    )
  }
</svg>
