---
// The one place on a page that offers help with the job itself: what Junk to
// Clear, a disposal company the family refers jobs to, can do in this
// situation, the enquiry form, and, only on guides where clearing is that
// page's own next step, a link to its page. It's labelled every
// time, and it says plainly that Junk to Clear is a separate company we refer
// jobs to, because a guide that points readers at a business without saying
// how it's connected is exactly the kind of page nobody should trust.
import type { HelpBox } from '../data/model';
import SectionIcon from './SectionIcon.astro';
import EnquiryForm from './EnquiryForm.astro';
import { site, withBase } from '../config/site';

export interface Props {
  help: HelpBox;
  /** The page the box is on, named in the enquiry's subject line. */
  page: { label: string; path: string };
  /** Section slug, for the icon beside the heading. */
  section?: string;
}

const { help, page, section } = Astro.props;
---

<aside class="help-box" aria-labelledby="help-heading">
  <p class="help-box__eyebrow">Help with the job</p>
  <div class="help-box__title">
    {section && <span class="help-box__icon"><SectionIcon slug={section} size={22} /></span>}
    <h2 id="help-heading">{help.heading}</h2>
  </div>
  <p>{help.body}</p>
  {/* A plain link: no "sponsored", since no fees are paid, and never noreferrer. */}
  {
    help.href && help.linkLabel && (
      <a class="btn btn--secondary" href={help.href} rel="noopener" target="_blank">
        {help.linkLabel}
        <span aria-hidden="true">↗</span>
      </a>
    )
  }
  {/* Every help box is about a clearance, so that need starts ticked. */}
  <EnquiryForm page={page} section={section} preselect={['Clearing and disposal']} heading="Ask for a quote" />
  <p class="help-box__disclosure">
    SwyftClear is run by {site.team}. {site.partner.name} is a separate company we refer jobs to, and it
    pays no referral fees. <a href={withBase('/about')}>How we work</a>.
  </p>
</aside>
