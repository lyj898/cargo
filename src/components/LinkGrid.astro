---
// Card grid for internal links: related guides, the guides in a section, the
// other sections. Every page carries at least one, so no guide is an orphan.
import type { LinkCard } from '../data/model';
import { withBase } from '../config/site';

export interface Props {
  links: LinkCard[];
  heading: string;
  eyebrow?: string;
  subtle?: boolean;
  showKind?: boolean;
  id?: string;
}

const { links, heading, eyebrow, subtle = false, showKind = false, id = 'links' } = Astro.props;

const sectionClass = ['section', 'section--border-top', subtle ? 'section--subtle' : ''].filter(Boolean).join(' ');

// Match the column count to the number of cards so no row is left half empty.
const gridClass = links.length % 3 === 0 ? 'grid grid--3' : links.length === 1 ? 'grid' : 'grid grid--2';
---

{
  links.length > 0 && (
    <section class={sectionClass} aria-labelledby={`${id}-heading`}>
      <div class="container stack">
        {eyebrow && <div class="eyebrow">{eyebrow}</div>}
        <h2 id={`${id}-heading`}>{heading}</h2>
        <div class={gridClass}>
          {links.map((l) => (
            <a class="service-card" href={withBase(l.href)} data-section={l.section}>
              {showKind && <span class="service-card__kind">{l.kind}</span>}
              <h3>{l.label}</h3>
              <p>{l.summary}</p>
              <div class="service-card__link">Read more →</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
