---
import type { CaseStudy } from '../data/caseStudies';

export interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<article class="case-card" id={study.slug}>
  <div class="eyebrow">{study.category}</div>
  <h3>{study.title}</h3>

  <div class="stack-sm" style="margin-top: var(--space-4);">
    <div>
      <h4 style="font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-faint);">Situation</h4>
      <p class="text-muted">{study.situation}</p>
    </div>
    <div>
      <h4 style="font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-faint);">Approach</h4>
      <p class="text-muted">{study.approach}</p>
    </div>
    <div>
      <h4 style="font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-faint);">Outcome</h4>
      <p class="text-muted">{study.outcome}</p>
    </div>
  </div>

  <dl>
    {
      study.details.map((d) => (
        <>
          <dt>{d.label}</dt>
          <dd>{d.value}</dd>
        </>
      ))
    }
  </dl>
</article>
