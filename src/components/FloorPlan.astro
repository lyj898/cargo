const plan = plans[variant];

// Door leaf + swing arc. The arc turns from the leaf toward the closed
// position; which way that is on screen decides the SVG sweep flag.
function doorPath({ h, l, c }: Door): string {
  const r = Math.hypot(l[0] - h[0], l[1] - h[1]);
  const cross = (l[0] - h[0]) * (c[1] - h[1]) - (l[1] - h[1]) * (c[0] - h[0]);
  const sweep = cross > 0 ? 1 : 0;
  return `M${h[0]} ${h[1]} L${l[0]} ${l[1]} A${r} ${r} 0 0 ${sweep} ${c[0]} ${c[1]}`;
}

// The doorway itself: a gap cut through the wall between hinge and closed end.
function gapRect({ h, c }: Door, thickness: number): Box {
  if (h[1] === c[1]) return { x: Math.min(h[0], c[0]), y: h[1] - thickness, w: Math.abs(c[0] - h[0]), h: thickness * 2 };
  return { x: h[0] - thickness, y: Math.min(h[1], c[1]), w: thickness * 2, h: Math.abs(c[1] - h[1]) };
}

// Tags size themselves to their text: the mono face is ~6.4 units per
// character at this size, plus room for the punched hole.
const tagBox = (t: Tag) => ({ ...t, w: Math.round(t.text.length * 6.4 + 26), h: 20 });

const stampText = variant === 'handover';
---

<svg
  class:list={['floor-plan', className]}
  viewBox="0 0 560 420"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <rect class="plan-sheet" x="0" y="0" width="560" height="420" rx="14"></rect>

  {plan.furniture.map((f) => <rect class="plan-item" x={f.x} y={f.y} width={f.w} height={f.h} rx={f.rx ?? 2}></rect>)}
  {plan.circles?.map((c) => <circle class="plan-item" cx={c.cx} cy={c.cy} r={c.r}></circle>)}
  {plan.dashed?.map((f) => <rect class="plan-partition" x={f.x} y={f.y} width={f.w} height={f.h}></rect>)}

  <rect class="plan-wall plan-wall--outer" x={plan.outer.x} y={plan.outer.y} width={plan.outer.w} height={plan.outer.h}></rect>
  {plan.walls.map((w) => <line class="plan-wall" x1={w.x1} y1={w.y1} x2={w.x2} y2={w.y2}></line>)}
  {plan.heavy?.map((w) => <line class="plan-wall plan-wall--heavy" x1={w.x1} y1={w.y1} x2={w.x2} y2={w.y2}></line>)}

  {
    plan.doors.map((d) => {
      const g = gapRect(d, 7);
      return <rect class="plan-gap" x={g.x} y={g.y} width={g.w} height={g.h}></rect>;
    })
  }
  {plan.doors.map((d) => <path class="plan-door" d={doorPath(d)}></path>)}

  {plan.shapes?.map((s) => <path class={`plan-shape plan-shape--${s.kind}`} d={s.d}></path>)}
  {
    stampText && (
      // "Vacant possession" stamped across the empty living room.
      <g class="plan-stamp" transform="rotate(-7 150 312)">
        <rect x="55" y="292" width="190" height="40" rx="3"></rect>
        <text x="150" y="316" text-anchor="middle">VACANT POSSESSION</text>
      </g>
    )
  }

  {
    plan.labels.map((t) => (
      <text class="plan-label" x={t.x} y={t.y} text-anchor={t.anchor ?? 'middle'}>
        {t.text}
      </text>
    ))
  }

  {
    plan.tags.map(tagBox).map((t) => (
      <g class={`plan-tag plan-tag--${t.tone}`}>
        <rect x={t.x} y={t.y} width={t.w} height={t.h} rx="4"></rect>
        <circle class="plan-tag__hole" cx={t.x + 9} cy={t.y + t.h / 2} r="2.6"></circle>
        <text x={t.x + 17} y={t.y + t.h / 2 + 3.6}>{t.text}</text>
      </g>
    ))
  }
</svg>
