---
// Line-drawn floor plans of the spaces the guides are about: a three-bedroom
// flat, a condo corridor, an office floor. Drawn from coordinates rather than
// imported artwork, so they pick up the theme tokens and read in dark mode.
//
// Every plan uses the same conventions as a real one: thick walls, doorways
// as gaps with a leaf and a swing arc, furniture in thin outline, room names
// in small capitals. Tags are the coloured labels people stick on things
// when they sort a home. They carry the idea of each section:
// keep / donate / clear, what stays at handover, a notice in a corridor,
// what to shred before a lease ends.

export type PlanVariant = 'sorting' | 'estates' | 'handover' | 'buildings' | 'business' | 'empty';

export interface Props {
  variant: PlanVariant;
  /** Accessible description. Omit to mark the drawing as decorative. */
  label?: string;
  class?: string;
}

const { variant, label, class: className } = Astro.props;

type Tone = 'sage' | 'amber' | 'teal' | 'plum' | 'accent';
type Box = { x: number; y: number; w: number; h: number; rx?: number };
type Seg = { x1: number; y1: number; x2: number; y2: number };
type Door = { h: [number, number]; l: [number, number]; c: [number, number] };
type Text = { x: number; y: number; text: string; anchor?: 'start' | 'middle' | 'end' };
type Tag = { x: number; y: number; text: string; tone: Tone };
type Shape = { d: string; kind: 'line' | 'wall' | 'accent' | 'solid' | 'dashed' };

type Plan = {
  outer: Box;
  walls: Seg[];
  heavy?: Seg[];
  doors: Door[];
  furniture: Box[];
  circles?: { cx: number; cy: number; r: number }[];
  dashed?: Box[];
  shapes?: Shape[];
  labels: Text[];
  tags: Tag[];
};

