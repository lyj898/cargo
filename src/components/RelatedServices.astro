---
import type { ServiceSummary } from '../data/services';

export interface Props {
  services: ServiceSummary[];
  heading?: string;
}

const { services, heading = 'Related service pages' } = Astro.props;
---

<section class="section section--subtle section--border-top" aria-labelledby="related-services-heading">
  <div class="container stack">
    <div class="eyebrow">Explore further</div>
    <h2 id="related-services-heading">{heading}</h2>
    <div class="grid grid--3">
      {
        services.map((s) => (
          <a class="service-card" href={`/${s.slug}`}>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <div class="service-card__link">Read more →</div>
          </a>
        ))
      }
    </div>
  </div>
</section>
