---
// Outbound links to the authorities that actually set the rules. These exist
// because the honest thing to do on a page about HDB, court, or NEA
// requirements is point at the source — and because a page that cites its
// authorities is a more trustworthy result than one that asserts them.
import type { OfficialSource } from '../data/model';

export interface Props {
  sources: OfficialSource[];
  note?: string;
}

const { sources, note } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="sources-block" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="fact-table__heading">Official sources</h2>
      <p class="text-muted">
        {note ??
          'Rules, fees and timelines change. These are the bodies that set them, so check the current position with them before you act on anything here.'}
      </p>
      <ul class="source-list">
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
