---
import ServicePageLayout from '../layouts/ServicePageLayout.astro';
import WhatToPrepare from '../components/WhatToPrepare.astro';
import { faqsBySlug } from '../data/faqs';

const slug = 'special-cargo-singapore';

const signs = [
  'The item doesn’t fit a standard courier or LCL/FCL freight category.',
  'You’ve been quoted conservatively, or told "we don’t usually handle this."',
  'It’s a one-off commercial import, not part of an ongoing shipping account.',
  'The value, material, or use of the item raises questions you can’t answer yet.',
  'You’re not sure which permits, if any, apply.',
];
---

<ServicePageLayout
  slug={slug}
  metaTitle="Special Cargo Into Singapore | Unusual & One-Off Shipments"
  metaDescription="Coordination for special cargo into Singapore — awkward, unusual, or one-off commercial shipments that don't fit a standard freight category. Guided assessment before quotation."
  breadcrumbLabel="Special cargo"
  eyebrow="Special cargo"
  h1="Special cargo into Singapore"
  lede="For shipments that don't fit a standard freight category — awkward shapes, unusual materials, one-off commercial goods, or anything a generalist forwarder has hesitated on."
  faqs={faqsBySlug[slug]}
  whatsappMessage="Hi SwyftClear, I have a special cargo shipment I'd like to ask about."
>
  <section class="section section--border-top" aria-labelledby="signs-heading">
    <div class="container stack">
      <div class="eyebrow">Is this you?</div>
      <h2 id="signs-heading">Signs your shipment counts as special cargo</h2>
      <ul class="trust-list">
        {signs.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--subtle section--border-top" aria-labelledby="approach-heading">
    <div class="container stack">
      <div class="eyebrow">How we approach it</div>
      <h2 id="approach-heading">Coordination built around the specifics of your job</h2>
      <p class="lede">
        Special cargo doesn’t follow a template, so we don’t assess it against one. We start by
        understanding what the item actually is — its dimensions, value, condition, and any handling
        constraints — then work out what documentation, delivery approach, and timing are realistic.
        Where the shipment may need customs or permit coordination, we flag that early rather than
        discovering it at the last stage.
      </p>
      <div class="grid grid--2">
        <div class="card">
          <h3 style="font-size: var(--step-0); font-family: var(--font-sans); font-weight: 700;">Commercial imports without a shipping history</h3>
          <p class="text-muted" style="margin-top: var(--space-2);">
            If this is your first time importing this type of item, we help you understand what a
            declaration is likely to need before the shipment is en route, not after.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--step-0); font-family: var(--font-sans); font-weight: 700;">Items with unusual packaging or materials</h3>
          <p class="text-muted" style="margin-top: var(--space-2);">
            Machinery parts, prototypes, cultural or promotional items, and similar goods often need a
            more specific description than a standard commodity code allows for.
          </p>
        </div>
      </div>
    </div>
  </section>

  <WhatToPrepare />
</ServicePageLayout>
