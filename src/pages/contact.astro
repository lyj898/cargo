---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, whatsappLink, withBase } from '../config/site';

const title = 'Contact CargoAdvisor.sg | Singapore Cargo & Customs Specialists';
const description =
  'Get in touch with CargoAdvisor.sg — WhatsApp, email, or start the guided enquiry for a proper assessment of your shipment.';
---

<BaseLayout title={title} description={description} path="/contact">
  <Breadcrumbs items={[{ label: 'Contact', href: '/contact' }]} />

  <section class="page-hero">
    <div class="container hero__content">
      <div class="eyebrow">Contact</div>
      <h1>Talk to us about your shipment</h1>
      <p class="lede">
        The fastest way to get a useful answer is the guided enquiry — it takes a few minutes and gives
        us what we need to assess your shipment properly. If you'd rather start with a quick message
        first, WhatsApp or email both work.
      </p>
    </div>
  </section>

  <section class="section section--border-top" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="visually-hidden">Contact options</h2>
    <div class="container">
      <div class="grid grid--3">
        <div class="card card--elevated stack-sm">
          <h3 style="font-size: var(--step-0); font-family: var(--font-sans); font-weight: 700;">Guided enquiry</h3>
          <p class="text-muted">The most useful starting point for any shipment, especially if it's unusual.</p>
          <a class="btn btn--primary btn--block" href={withBase('/enquiry')}>{site.ctaPrimaryLabel}</a>
        </div>
        <div class="card card--elevated stack-sm">
          <h3 style="font-size: var(--step-0); font-family: var(--font-sans); font-weight: 700;">WhatsApp</h3>
          <p class="text-muted">Good for a quick question before you commit to the full enquiry.</p>
          <a class="btn btn--whatsapp btn--block" href={whatsappLink('Hi CargoAdvisor, I have a question about a shipment.')} rel="noopener" target="_blank">
            {site.ctaSecondaryLabel}
          </a>
        </div>
        <div class="card card--elevated stack-sm">
          <h3 style="font-size: var(--step-0); font-family: var(--font-sans); font-weight: 700;">Email</h3>
          <p class="text-muted">If you'd rather send documents or details in writing.</p>
          <a class="btn btn--secondary btn--block" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>

      <p class="text-faint" style="margin-top: var(--space-6); font-size: var(--step--1);">
        Based in Singapore, coordinating shipments in and around Singapore. We aim to respond within
        one business day.
      </p>
    </div>
  </section>
</BaseLayout>
