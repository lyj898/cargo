---
import ClusterPageLayout from '../../layouts/ClusterPageLayout.astro';
import OfficialSources from '../../components/OfficialSources.astro';
import { permitTopics, permitToSpoke } from '../../data/permits';
import { LAST_REVIEWED_DISPLAY } from '../../config/content';

export function getStaticPaths() {
  return permitTopics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const spoke = permitToSpoke(topic);
---

<ClusterPageLayout
  base="permits"
  spoke={spoke}
  factsCaption="The short answer"
  whatsappMessage={`Hi SwyftClear, I want to import ${topic.name} into Singapore and need help working out what applies.`}
>
  <OfficialSources
    sources={[{ label: topic.authority, url: topic.authorityUrl }, { label: 'Singapore Customs', url: 'https://www.customs.gov.sg' }]}
    note="Control status depends on the specific product, and requirements change. These are the authorities that decide — confirm your particular goods with them before shipping."
  />

  <section class="section section--tight">
    <div class="container">
      <p class="text-faint" style="font-size: var(--step--1);">
        Last reviewed {LAST_REVIEWED_DISPLAY}. This page describes the general framework for this
        category of goods. It does not determine whether your specific product is controlled — only
        the relevant Competent Authority can do that.
      </p>
    </div>
  </section>
</ClusterPageLayout>
