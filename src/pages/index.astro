---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloorPlan from '../components/FloorPlan.astro';
import SectionIcon from '../components/SectionIcon.astro';
import SectionTag from '../components/SectionTag.astro';
import { hubs } from '../data/hubs';
import { guides, guidesIn, guidePath, toolsIn, tools } from '../data/library';
import { site, withBase } from '../config/site';
import { LAST_REVIEWED_DISPLAY } from '../config/content';

const title = 'SwyftClear | Clearing a Home or Premises in Singapore';
const description =
  'Singapore guides for clearing a property you’re responsible for: a late relative’s home, a sold or rented home, condo common areas, or premises at lease end.';

const panels = hubs.map((hub) => ({
  hub,
  links: [
    ...guidesIn(hub.slug).map((g) => ({ href: guidePath(g), label: g.label })),
    ...toolsIn(hub.slug).map((t) => ({ href: t.href, label: t.label })),
  ],
}));

// Counted from the guides themselves, so the numbers under the hero can't
// drift from what the pages actually cite.
const officialSourceCount = new Set(guides.flatMap((g) => g.sources.map((s) => s.url))).size;

const principles = [
  {
    title: 'Free routes first',
    body: 'Town council bulky-item removal, e-waste collection points and donation come before any paid clearance. Where a free route fits, the guide says so.',
  },
  {
    title: 'Rules linked to their source',
    body: 'Anything about HDB, the courts, NEA, BCA or the PDPC links to the official page it comes from, and every guide carries the date it was last checked.',
  },
  {
    title: 'Open about who we are',
    body: `SwyftClear is published by the company behind ${site.publisher.brand}. Each guide has one clearly labelled box about its services. Nothing else on the page is an advert.`,
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <section class="hero">
    <div class="container home-hero">
      <div class="hero__content">
        <div class="eyebrow">Singapore clearance guides</div>
        <h1>Clearing a property you’re responsible for</h1>
        <p class="lede">
          Plain guides for when you have to empty a home or premises you don’t live in, by a date
          someone else has set: after a death, at the end of a sale or a tenancy, in a condo’s common
          areas, or when a business lease runs out.
        </p>
        <div class="hero__chooser" aria-label="Choose your situation">
          {hubs.map((h) => <SectionTag slug={h.slug} label={h.label} href={`/${h.slug}`} scoped />)}
        </div>
        <ul class="hero__facts">
          <li><strong>{guides.length}</strong> guides</li>
          <li><strong>{officialSourceCount}</strong> official sources cited</li>
          <li>Checked <strong>{LAST_REVIEWED_DISPLAY}</strong></li>
        </ul>
      </div>

      <figure class="plan-frame plan-frame--hero">
        <FloorPlan
          variant="sorting"
          label="Floor plan of a three-bedroom flat, with the furniture tagged keep, donate and clear, and the household shelter tagged check first."
        />
        <figcaption>Plan 01 · A three-bedroom flat, sorted before anything leaves</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="situations-heading">
    <div class="container stack">
      <div class="eyebrow">Start with your situation</div>
      <h2 id="situations-heading">Who has to clear it, and by when</h2>
      <div class="hub-grid">
        {
          panels.map(({ hub, links }) => (
            <div class="hub-panel" data-section={hub.slug}>
              <div class="hub-panel__head">
                <span class="hub-panel__icon">
                  <SectionIcon slug={hub.slug} size={22} />
                </span>
                <span class="hub-panel__audience">{hub.audience}</span>
              </div>
              <h3>
                <a href={withBase(`/${hub.slug}`)}>{hub.h1}</a>
              </h3>
              <p class="text-muted">{hub.summary}</p>
              {links.length > 0 && (
                <ul>
                  {links.map((l) => (
                    <li>
                      <a href={withBase(l.href)}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              )}
              <p class="hub-panel__more">
                <a href={withBase(`/${hub.slug}`)}>All of {hub.label.toLowerCase()} →</a>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    tools.length > 0 && (
      <section class="section section--subtle section--border-top" aria-labelledby="tools-heading">
        <div class="container stack">
          <div class="eyebrow">Tools</div>
          <h2 id="tools-heading">Things you can use straight away</h2>
          {tools.map((t) => (
            <a class="tool-feature" href={withBase(t.href)} data-section={t.section}>
              <div class="tool-feature__text">
                <span class="service-card__kind">{t.kind}</span>
                <h3>{t.label}</h3>
                <p>{t.summary}</p>
                <span class="tool-feature__cta">Open the templates →</span>
              </div>
              <div class="tool-feature__plan">
                <FloorPlan variant="buildings" />
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="section section--border-top" aria-labelledby="how-heading">
    <div class="container stack">
      <div class="eyebrow">How these guides are written</div>
      <h2 id="how-heading">Useful before you book anyone</h2>
      <div class="principles">
        {
          principles.map((p) => (
            <div class="principle">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
      <p class="text-muted">
        <a href={withBase('/about')}>Who publishes SwyftClear, and what that means for the guides →</a>
      </p>
    </div>
  </section>
</BaseLayout>
