---
// Human-readable sitemap. It gives visitors a way to see the whole site at
// once, and gives crawlers a single page that links to every URL.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { hubs } from '../data/hubs';
import { guides, guidesIn, guidePath, toolsIn, tools } from '../data/library';
import { withBase } from '../config/site';

const corePages = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'Who publishes SwyftClear' },
];

const totalPages = corePages.length + hubs.length + guides.length + tools.length + 1;
---

<BaseLayout
  title="Site map"
  description="Every page on SwyftClear: guides for clearing a late relative’s home, handing over a sold or rented home, condo bulky waste, and business premises."
  path="/sitemap"
>
  <Breadcrumbs items={[{ label: 'Site map', href: '/sitemap' }]} />

  <header class="page-hero">
    <div class="container">
      <div class="hero__content">
        <div class="eyebrow">Site map</div>
        <h1>Everything on this site</h1>
        <p class="lede">
          {totalPages} pages, grouped by the situation they’re written for. If you’re looking for
          something specific, this is the fastest way to find it.
        </p>
      </div>
    </div>
  </header>

  <section class="section section--border-top">
    <div class="container stack">
      <div class="sitemap-group">
        <h2>Main pages</h2>
        <ul class="sitemap-list">
          {corePages.map((p) => <li><a href={withBase(p.href)}>{p.label}</a></li>)}
          <li><a href={withBase('/sitemap')}>Site map</a></li>
        </ul>
      </div>

      {
        hubs.map((h) => (
          <div class="sitemap-group">
            <h2>
              <a href={withBase(`/${h.slug}`)}>{h.h1}</a>
            </h2>
            <ul class="sitemap-list">
              {guidesIn(h.slug).map((g) => (
                <li>
                  <a href={withBase(guidePath(g))}>{g.label}</a>
                </li>
              ))}
              {toolsIn(h.slug).map((t) => (
                <li>
                  <a href={withBase(t.href)}>{t.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
