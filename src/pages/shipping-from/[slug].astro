---
import ClusterPageLayout from '../../layouts/ClusterPageLayout.astro';
import { countries, countryToSpoke } from '../../data/countries';
import { site, absoluteUrl } from '../../config/site';

export function getStaticPaths() {
  return countries.map((country) => ({
    params: { slug: country.slug },
    props: { country },
  }));
}

const { country } = Astro.props;
const spoke = countryToSpoke(country);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: `Freight and customs coordination, ${country.titleName} to Singapore`,
  name: spoke.metaTitle,
  description: spoke.metaDescription,
  url: absoluteUrl(`/shipping-from/${country.slug}`),
  provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
  areaServed: [
    { '@type': 'Country', name: 'Singapore' },
    { '@type': 'Country', name: country.titleName },
  ],
};
---

<ClusterPageLayout
  base="shipping-from"
  spoke={spoke}
  jsonLd={[serviceSchema]}
  factsCaption={`${country.titleName} to Singapore at a glance`}
  whatsappMessage={`Hi SwyftClear, I have a shipment coming from ${country.titleName} to Singapore.`}
>
  <section class="section section--tight">
    <div class="container">
      <p class="text-faint" style="font-size: var(--step--1);">
        Transit ranges on this page are indicative planning figures for a direct or typical routing.
        They are not quotations, and actual timing depends on the load port, sailing frequency,
        transshipment, and seasonal capacity.
      </p>
    </div>
  </section>
</ClusterPageLayout>
