---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GuideBody from '../components/GuideBody.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import type { Section } from '../data/model';
import { site } from '../config/site';
import { LAST_REVIEWED_DISPLAY } from '../config/content';

const title = 'About SwyftClear: Who Publishes These Guides';
const description =
  'SwyftClear is published by SKAP Waste Management Pte Ltd, the company behind Junk to Clear. Why the site exists, how the guides are written, and what we won’t do.';

const { legalName, brand, foundingYear } = site.publisher;

const sections: Section[] = [
  {
    heading: 'Who publishes this site',
    body: [
      `SwyftClear is published by **${legalName}**, a Singapore company established in ${foundingYear}. The same company runs [${brand}](${site.publisher.url}), a disposal and clearance service, and the HomeToClean and HomeToMoved brands. SwyftClear is also part of OurKampung, a family of Singapore guide and service sites run by the same team, and OurKampung keeps [a list of every site and what it covers](https://ourkampung.com/our-sites/).`,
      'We say this first because it matters for how you read everything else. A clearance company has an obvious interest in you hiring a clearance company. You should know that before you take our word on when you need one.',
    ],
  },
  {
    heading: 'Why it exists',
    body: [
      'Most of the hard questions in a clearance have nothing to do with the lorry. Who is allowed to decide what goes? What has to be gone by completion day? Can the management remove a sofa from the corridor, and what notice should it give? What happens to the data on the office laptops?',
      'Those questions tend to come up late, when the deadline is close and the answer is harder to act on. SwyftClear answers them earlier, for the four situations where someone has to clear a property they don’t live in: when a home is sold or let, in a condo or strata building, at the end of a business lease, and when a family home passes to the estate.',
    ],
  },
  {
    heading: 'How the guides handle who we are',
    body: ['These are the rules every guide follows:'],
    bullets: [
      `Each guide has **one** box about ${brand}’s services, near the end, and it is always labelled as coming from the company behind this site. The box is also where you can ask for a quote.`,
      `Inside the guides, we link to ${brand} only where you would actually need a clearance at that point. There are no links to it in the site’s header or footer.`,
      'Free routes come first. Where a town council removal, an e-waste collection point, a donation or a resale would do the job, the guide says so before it mentions paying anyone.',
      'We don’t rank or review disposal companies, including our own, and we don’t publish testimonials.',
    ],
  },
  {
    heading: 'How the guides are written and checked',
    body: [
      'Anything that depends on a rule, such as HDB’s requirements when a flat passes to an estate, what the courts need before an estate can be dealt with, NEA’s e-waste arrangements, or the PDPC’s expectations for disposing of personal data, links to the official page it comes from. Where an official source doesn’t cover something, the guide says it’s general practice rather than a rule.',
      `Every guide shows the date it was last reviewed against those sources. The current review date is ${LAST_REVIEWED_DISPLAY}. Rules change, and when they do, the official source is right and we are out of date.`,
    ],
  },
  {
    heading: 'What SwyftClear is not',
    body: [
      'It isn’t legal advice. Estates, sale contracts, tenancy agreements and leases turn on their own wording, and where there is a dispute or a lot of money at stake, you should speak to a lawyer. It isn’t a government site, and it isn’t a directory or a comparison site.',
    ],
  },
];

// After the enquiry box, so the notice on what happens to an enquiry follows
// the form it describes.
const afterEnquiry: Section[] = [
  {
    heading: 'Privacy and analytics',
    body: [
      `The enquiry form is the only place the site asks for your details. What you enter, with the page you sent it from, is emailed to the team behind ${brand} at ${legalName} through FormSubmit, a form-to-email service. The team uses it only for your enquiry: it passes your details to the partner who’ll quote, whether that’s ${brand} or a partner for cleaning, moving, repairs, pest control or aircon. To see, correct or delete what you sent, or to withdraw your consent, email [${site.email}](mailto:${site.email}).`,
      'SwyftClear uses Google Analytics to count visits and see which guides get read, so we know what to improve. It sets cookies and records things like the pages you view, the device and browser you use, roughly where you’re browsing from, and the links you click, including links to Junk to Clear. When you send an enquiry, it records that one was sent, but not what you wrote.',
      'Nothing you type into the notice templates leaves your browser. You can block analytics cookies in your browser settings, or install Google’s [Analytics opt-out add-on](https://tools.google.com/dlpage/gaoptout).',
    ],
  },
  {
    heading: 'Corrections',
    body: [
      `If something in a guide is wrong or out of date, email [${site.email}](mailto:${site.email}). We would rather hear it from you than have someone act on it.`,
      'Until September 2026 this address carried a cargo and customs guide. That site has closed, and its pages have been taken down rather than redirected here, because they covered a different subject.',
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/about">
  <Breadcrumbs items={[{ label: 'About', href: '/about' }]} />

  <header class="page-hero">
    <div class="container">
      <div class="hero__content">
        <div class="eyebrow">About</div>
        <h1>Who publishes SwyftClear, and why</h1>
        <p class="lede">
          SwyftClear is a set of Singapore guides for people who have to clear a property they’re
          responsible for. It’s published by the company behind {brand}, and this page explains what
          that means for the guides.
        </p>
      </div>
    </div>
  </header>

  <div class="container article-body">
    <GuideBody sections={sections} />
    <aside class="help-box" aria-labelledby="ask-for-a-quote">
      <p class="help-box__eyebrow">From the company behind SwyftClear</p>
      <h2 id="ask-for-a-quote">Ask for a quote</h2>
      <p>
        If you’d rather hand the job over, tell us what you need. The team behind {brand} reads
        every enquiry and passes it to the partner who’ll quote: {brand} for clearing and disposal,
        or a partner for cleaning, moving, repairs, pest control or aircon.
      </p>
      <EnquiryForm page={{ label: 'About', path: '/about' }} section="about" />
    </aside>
    <GuideBody sections={afterEnquiry} />
  </div>
</BaseLayout>
