---
import ClusterPageLayout from '../../layouts/ClusterPageLayout.astro';
import { cargoTypes, cargoToSpoke } from '../../data/cargo';
import { site, absoluteUrl } from '../../config/site';

export function getStaticPaths() {
  return cargoTypes.map((cargo) => ({
    params: { slug: cargo.slug },
    props: { cargo },
  }));
}

const { cargo } = Astro.props;
const spoke = cargoToSpoke(cargo);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: `Import coordination for ${cargo.name}`,
  name: spoke.metaTitle,
  description: spoke.metaDescription,
  url: absoluteUrl(`/cargo/${cargo.slug}`),
  provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
  areaServed: { '@type': 'Country', name: 'Singapore' },
};
---

<ClusterPageLayout
  base="cargo"
  spoke={spoke}
  jsonLd={[serviceSchema]}
  factsCaption="Shipping profile"
  whatsappMessage={`Hi SwyftClear, I need to ship ${cargo.name} into Singapore and would like it assessed.`}
/>
