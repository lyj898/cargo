---
import ClusterPageLayout from '../../layouts/ClusterPageLayout.astro';
import OfficialSources from '../../components/OfficialSources.astro';
import { guides, guideToSpoke } from '../../data/guides';
import { LAST_REVIEWED_DISPLAY } from '../../config/content';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const spoke = guideToSpoke(guide);
---

<ClusterPageLayout
  base="guides"
  spoke={spoke}
  keyPoints={guide.keyPoints}
  factsCaption="At a glance"
  whatsappMessage={`Hi SwyftClear, I read your guide on ${guide.label.toLowerCase()} and have a question about my shipment.`}
>
  <OfficialSources sources={guide.officialSources} />

  <section class="section section--tight">
    <div class="container">
      <p class="text-faint" style="font-size: var(--step--1);">
        Last reviewed {LAST_REVIEWED_DISPLAY}. This page explains how the process generally works; it
        is not advice on your specific shipment, and it does not replace guidance from Singapore
        Customs, the relevant Competent Authority, or a licensed Declaring Agent.
      </p>
    </div>
  </section>
</ClusterPageLayout>
