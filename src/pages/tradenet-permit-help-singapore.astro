---
import ServicePageLayout from '../layouts/ServicePageLayout.astro';
import { faqsBySlug } from '../data/faqs';

const slug = 'tradenet-permit-help-singapore';

const glossary = [
  { term: 'TradeNet', def: 'Singapore’s national single window for submitting trade declarations, including import and export permit applications, to the relevant government agencies.' },
  { term: 'UEN', def: 'The Unique Entity Number issued to businesses and other entities registered in Singapore — generally required before a Customs Account can be activated.' },
  { term: 'Customs Account', def: 'An account activated with Singapore Customs that a business generally needs before it (or its Declaring Agent) can submit permit applications via TradeNet.' },
  { term: 'Declaring Agent', def: 'A party authorised to submit permit declarations on TradeNet on behalf of an importer or exporter. Many first-time or infrequent importers appoint one rather than applying directly.' },
];
---

<ServicePageLayout
  slug={slug}
  metaTitle="TradeNet Permit Help Singapore | Import Permit Guidance"
  metaDescription="Plain-language guidance on Singapore's TradeNet import permit process — what a UEN and Customs Account are for, what a Declaring Agent does, and how to prepare before applying."
  breadcrumbLabel="TradeNet permit help"
  eyebrow="TradeNet & permits"
  h1="TradeNet permit guidance for Singapore imports"
  lede="A plain-language explanation of how import permits work in Singapore — and help preparing the information a declaration is likely to need, before you're under time pressure."
  faqs={faqsBySlug[slug]}
  whatsappMessage="Hi CargoAdvisor, I need help understanding the TradeNet permit process for an import."
>
  <section class="section section--border-top" aria-labelledby="glossary-heading">
    <div class="container stack">
      <div class="eyebrow">The terms, explained plainly</div>
      <h2 id="glossary-heading">TradeNet, UEN, Customs Account, and Declaring Agent</h2>
      <div class="grid grid--2">
        {
          glossary.map((item) => (
            <div class="card">
              <h3 style="font-size: var(--step-0); font-family: var(--font-sans); font-weight: 700;">{item.term}</h3>
              <p class="text-muted" style="margin-top: var(--space-2);">{item.def}</p>
            </div>
          ))
        }
      </div>
      <p class="text-faint" style="font-size: var(--step--1);">
        This is a general explanation, not legal or regulatory advice, and requirements can change.
        Always confirm current requirements for your specific goods with Singapore Customs or a
        licensed Declaring Agent.
      </p>
    </div>
  </section>

  <section class="section section--subtle section--border-top" aria-labelledby="sequence-heading">
    <div class="container stack">
      <div class="eyebrow">Typical sequence</div>
      <h2 id="sequence-heading">Roughly how the process fits together</h2>
      <ol class="steps-list">
        <li>
          <span class="step-num" aria-hidden="true">1</span>
          <h3>Business registration &amp; UEN</h3>
          <p>Your business needs a UEN before the next steps can proceed.</p>
        </li>
        <li>
          <span class="step-num" aria-hidden="true">2</span>
          <h3>Customs Account activation</h3>
          <p>Activated with Singapore Customs, generally a one-time setup step.</p>
        </li>
        <li>
          <span class="step-num" aria-hidden="true">3</span>
          <h3>Declaring Agent appointed</h3>
          <p>Many businesses appoint one to handle the TradeNet submission itself.</p>
        </li>
        <li>
          <span class="step-num" aria-hidden="true">4</span>
          <h3>Permit application via TradeNet</h3>
          <p>Submitted with the shipment’s commercial and product details.</p>
        </li>
      </ol>
      <p class="lede">
        If you’re at step one and don’t know where to start, that’s a normal place to be. Tell us in
        the guided enquiry and we’ll help you understand what applies to your specific shipment.
      </p>
    </div>
  </section>
</ServicePageLayout>
