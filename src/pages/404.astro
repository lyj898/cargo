---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkGrid from '../components/LinkGrid.astro';
import { hubs } from '../data/hubs';
import { withBase } from '../config/site';

// A 404 that only offers "go home" wastes the visit. Most people who land here
// arrived from a search result or an old link, and until late 2026 many of
// those will be links to the cargo guide this domain used to carry, so say so
// plainly and put the sections in front of them.
const hubLinks = hubs.map((h) => ({
  href: `/${h.slug}`,
  label: h.h1,
  summary: h.summary,
  kind: h.label,
}));
---

<BaseLayout title="Page not found" description="This page doesn't exist." path="/404" noIndex>
  <section class="section" style="padding-block: var(--space-8);">
    <div class="container stack" style="text-align: center;">
      <div class="eyebrow" style="justify-content: center;">404</div>
      <h1>We couldn't find that page</h1>
      <p class="lede" style="margin-inline: auto;">
        The page may have moved, or the link may be out of date. If you were looking for SwyftClear’s
        old cargo and customs guides, those have been taken down. The site now covers clearing a
        property you’re responsible for.
      </p>
      <p>
        <a href={withBase('/')}>← Back to homepage</a>
        <span style="color: var(--color-border-strong); margin-inline: var(--space-3);">·</span>
        <a href={withBase('/sitemap')}>See every page</a>
      </p>
    </div>
  </section>

  <LinkGrid links={hubLinks} heading="Browse by situation" subtle id="hubs" />
</BaseLayout>
