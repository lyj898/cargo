---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { caseStudies } from '../data/caseStudies';

const title = 'Case Studies | SwyftClear.com';
const description =
  'Illustrative examples of special cargo, exhibition logistics, and fragile equipment coordination for Singapore shipments.';
---

<BaseLayout title={title} description={description} path="/case-studies">
  <Breadcrumbs items={[{ label: 'Case studies', href: '/case-studies' }]} />

  <section class="page-hero">
    <div class="container hero__content">
      <div class="eyebrow">Case studies</div>
      <h1>How unusual shipments actually get handled</h1>
      <p class="lede">
        A few illustrative examples of the kind of jobs we coordinate. Details are simplified and
        anonymised — the point is to show the shape of the problem and the shape of the solution.
      </p>
    </div>
  </section>

  <section class="section section--border-top" aria-labelledby="studies-heading">
    <h2 id="studies-heading" class="visually-hidden">Case studies</h2>
    <div class="container">
      <div class="grid" style="gap: var(--space-6);">
        {caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </section>
</BaseLayout>
