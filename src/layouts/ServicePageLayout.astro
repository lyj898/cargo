---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedServices from '../components/RelatedServices.astro';
import LinkGrid from '../components/LinkGrid.astro';
import { site, absoluteUrl } from '../config/site';
import { relatedServices, getService } from '../data/services';
import { resolveLinks } from '../data/clusters';
import type { Faq } from '../data/faqs';

export interface Props {
  slug: string;
  metaTitle: string;
  metaDescription: string;
  breadcrumbLabel: string;
  eyebrow: string;
  h1: string;
  lede: string;
  faqs: Faq[];
  whatsappMessage?: string;
}

const { slug, metaTitle, metaDescription, breadcrumbLabel, eyebrow, h1, lede, faqs, whatsappMessage } = Astro.props;

// Service pages carry the most authority on the site, so they are where the
// programmatic clusters get their strongest internal links from.
const clusterLinks = resolveLinks(getService(slug)?.clusterLinks ?? [], 6);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: h1,
  name: metaTitle,
  description: metaDescription,
  url: absoluteUrl(`/${slug}`),
  provider: {
    '@type': 'ProfessionalService',
    name: site.name,
    url: site.url,
  },
  areaServed: {
    '@type': 'Country',
    name: 'Singapore',
  },
};
---

<BaseLayout title={metaTitle} description={metaDescription} path={`/${slug}`} jsonLd={[serviceSchema]}>
  <Breadcrumbs items={[{ label: breadcrumbLabel, href: `/${slug}` }]} />

  <section class="page-hero">
    <div class="container hero__content">
      <div class="eyebrow">{eyebrow}</div>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
    </div>
  </section>

  <slot />

  <FAQSection faqs={faqs} heading={`Questions about ${eyebrow.toLowerCase()}`} id="faq" />

  <LinkGrid
    links={clusterLinks}
    heading="Work out the details"
    eyebrow="Reference"
    showKind
    id="reference"
  />

  <RelatedServices services={relatedServices(slug)} />
</BaseLayout>
