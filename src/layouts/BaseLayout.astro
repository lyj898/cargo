---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, absoluteUrl, withBase } from '../config/site';
import { pageGraph, type JsonLdNode } from '../utils/schema';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  /** Page-level schema nodes, merged into the page's single @graph. */
  jsonLd?: JsonLdNode[];
  /** ISO date; emitted as article:modified_time on guide pages. */
  modified?: string;
  /** Section slug. Sets the page's label colour (see [data-section] in CSS). */
  section?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  ogType = 'website',
  noIndex = false,
  jsonLd = [],
  modified,
  section,
} = Astro.props;

const canonical = absoluteUrl(path);

// Brand suffix, but only when it fits. Google shows roughly 60 characters of a
// title and rewrites anything it truncates, so on the guides, whose titles are
// already long and descriptive, the question is worth more than the brand.
const BRAND_SUFFIX_BUDGET = 45;
const fullTitle =
  title.includes(site.name) || title.length > BRAND_SUFFIX_BUDGET
    ? title
    : `${title} | ${site.name}`;

// NOTE: og-default.svg is an SVG, and Facebook, X, and Google Discover do not
// render SVG social cards — they fall back to no image. Replacing it with a
// 1200x630 PNG is the highest-value social fix outstanding; it needs an image
// pipeline this build deliberately avoids.
const ogPath = ogImage ?? '/og-default.svg';

const graph = pageGraph(jsonLd);
const gaId = site.ga4MeasurementId;
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#f3f5f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f161c" media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(ogPath)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_SG" />
    {modified && <meta property="article:modified_time" content={modified} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(ogPath)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body data-section={section}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
