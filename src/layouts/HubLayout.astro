---
// A section hub: what the situation involves, then every guide and tool in it.
// The overview prose is what keeps a hub from being a bare list of links, and
// the plan beside the heading shows the space the section is about.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GuideBody from '../components/GuideBody.astro';
import HelpBox from '../components/HelpBox.astro';
import LinkGrid from '../components/LinkGrid.astro';
import FloorPlan, { type PlanVariant } from '../components/FloorPlan.astro';
import SectionTag from '../components/SectionTag.astro';
import type { Hub, LinkCard } from '../data/model';
import { hubs } from '../data/hubs';
import { guidesIn, guidePath, readingMinutes, toolsIn } from '../data/library';
import { absoluteUrl, withBase } from '../config/site';
import { LAST_REVIEWED } from '../config/content';
import { collectionNode } from '../utils/schema';

export interface Props {
  hub: Hub;
}

const { hub } = Astro.props;
const path = `/${hub.slug}`;

type Card = LinkCard & { meta: string };
const cards: Card[] = [
  ...guidesIn(hub.slug).map((g) => ({
    href: guidePath(g),
    label: g.label,
    summary: g.summary,
    kind: 'Guide',
    meta: `${readingMinutes(g)} min read`,
  })),
  ...toolsIn(hub.slug).map((t) => ({ ...t, meta: 'Fill in and print' })),
];

// Match the column count to the number of cards so no row is left half empty.
const gridClass = cards.length % 3 === 0 ? 'grid grid--3' : 'grid grid--2';

const planFor: Record<string, PlanVariant> = {
  estates: 'estates',
  handover: 'handover',
  buildings: 'buildings',
  business: 'business',
};

const otherHubs: LinkCard[] = hubs
  .filter((h) => h.slug !== hub.slug)
  .map((h) => ({ href: `/${h.slug}`, label: h.h1, summary: h.summary, kind: h.label, section: h.slug }));
---

<BaseLayout
  title={hub.metaTitle}
  description={hub.metaDescription}
  path={path}
  modified={LAST_REVIEWED}
  section={hub.slug}
  jsonLd={[
    collectionNode({
      url: absoluteUrl(path),
      name: hub.h1,
      description: hub.metaDescription,
      items: cards.map((c) => ({ name: c.label, url: absoluteUrl(c.href) })),
    }),
  ]}
>
  <Breadcrumbs items={[{ label: hub.label, href: path }]} />

  <header class="page-hero page-hero--hub">
    <div class="container hub-hero">
      <div class="hero__content">
        <SectionTag slug={hub.slug} label={hub.label} />
        <h1>{hub.h1}</h1>
        <p class="lede">{hub.lede}</p>
        <p class="hub-hero__audience">{hub.audience}</p>
      </div>
      <div class="plan-frame">
        <FloorPlan variant={planFor[hub.slug] ?? 'sorting'} />
      </div>
    </div>
  </header>

  <section class="section section--tight" aria-labelledby="in-this-section">
    <div class="container stack">
      <h2 id="in-this-section" class="fact-table__heading">In this section</h2>
      <div class={gridClass}>
        {
          cards.map((c) => (
            <a class="service-card guide-card" href={withBase(c.href)}>
              <span class="service-card__kind">{c.kind}</span>
              <h3>{c.label}</h3>
              <p>{c.summary}</p>
              <div class="guide-card__foot">
                <span>{c.meta}</span>
                <span class="guide-card__arrow" aria-hidden="true">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container article-body article-body--hub">
    <GuideBody sections={hub.sections} />
    <HelpBox help={hub.help} section={hub.slug} page={{ label: hub.label, path }} />
  </div>

  <LinkGrid links={otherHubs} heading="Other situations" eyebrow="Elsewhere on SwyftClear" subtle id="other-hubs" />
</BaseLayout>
