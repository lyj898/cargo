---
// Shared layout for every guide. One layout keeps the schema, the disclosure,
// the sources, and the review line identical across the library, so improving
// any of them improves all of them at once.
//
// On wide screens the article sits beside a sticky rail holding the contents
// list and the review record; on narrow screens the contents list becomes a
// row of pills above the article instead.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import KeyPoints from '../components/KeyPoints.astro';
import OnThisPage from '../components/OnThisPage.astro';
import GuideBody from '../components/GuideBody.astro';
import HelpBox from '../components/HelpBox.astro';
import FAQSection from '../components/FAQSection.astro';
import OfficialSources from '../components/OfficialSources.astro';
import LinkGrid from '../components/LinkGrid.astro';
import SectionTag from '../components/SectionTag.astro';
import type { Guide } from '../data/model';
import { getHub } from '../data/hubs';
import { guidePath, readingMinutes, resolveLinks } from '../data/library';
import { site, absoluteUrl } from '../config/site';
import { LAST_REVIEWED, LAST_REVIEWED_DISPLAY } from '../config/content';
import { articleNode } from '../utils/schema';

export interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const hub = getHub(guide.hub);
if (!hub) throw new Error(`Guide ${guide.slug} points at unknown section "${guide.hub}"`);

const path = guidePath(guide);
const related = resolveLinks(guide.related, 3);
const minutes = readingMinutes(guide);
const headings = guide.sections.map((s) => s.heading);
const hasFaqs = guide.faqs.length > 0;
---

<BaseLayout
  title={guide.metaTitle}
  description={guide.metaDescription}
  path={path}
  ogType="article"
  modified={LAST_REVIEWED}
  section={hub.slug}
  jsonLd={[
    articleNode({
      url: absoluteUrl(path),
      headline: guide.h1,
      description: guide.metaDescription,
      sectionName: hub.label,
    }),
  ]}
>
  <Breadcrumbs
    items={[
      { label: hub.label, href: `/${hub.slug}` },
      { label: guide.label, href: path },
    ]}
  />

  <article>
    <header class="page-hero page-hero--guide">
      <div class="container">
        <div class="hero__content">
          <SectionTag slug={hub.slug} label={hub.label} href={`/${hub.slug}`} />
          <h1>{guide.h1}</h1>
          <p class="lede">{guide.lede}</p>
          <ul class="guide-meta" aria-label="About this guide">
            <li>Reviewed <time datetime={LAST_REVIEWED}>{LAST_REVIEWED_DISPLAY}</time></li>
            <li>{minutes} min read</li>
            {guide.sources.length > 0 && <li><a href="#sources">{guide.sources.length} official sources</a></li>}
          </ul>
        </div>
      </div>
    </header>

    <div class="container guide-layout">
      <div class="article-body">
        <KeyPoints points={guide.keyPoints} />
        <OnThisPage headings={headings} includeFaq={hasFaqs} variant="pills" />
        <GuideBody sections={guide.sections} />
        <HelpBox help={guide.help} section={hub.slug} page={{ label: guide.label, path }} />
        <FAQSection faqs={guide.faqs} heading="Questions people ask" id="faq" />
        <OfficialSources sources={guide.sources} />
        <p class="review-note">
          Last reviewed {LAST_REVIEWED_DISPLAY}. This is general information about how things
          usually work in Singapore, not legal advice on your situation. If something here is out of
          date, please tell us at <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>

      <aside class="guide-rail" aria-label="Guide contents">
        <div class="guide-rail__inner">
          <OnThisPage headings={headings} includeFaq={hasFaqs} variant="rail" />
          <div class="guide-rail__record">
            <span class="toc__label">Checked against</span>
            <p>
              {guide.sources.length} official sources, last reviewed {LAST_REVIEWED_DISPLAY}.
              <a href="#sources">See the list</a>
            </p>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <LinkGrid links={related} heading="Related guides" eyebrow="Keep reading" subtle id="related" />
</BaseLayout>
