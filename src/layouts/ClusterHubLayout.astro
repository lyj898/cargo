---
// Hub page for a cluster. Lists every spoke, grouped, and carries ItemList
// schema so the set is legible as a collection rather than a wall of links.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LinkGrid from '../components/LinkGrid.astro';
import type { ClusterDef } from '../data/clusters';
import { clusters } from '../data/clusters';
import { withBase, absoluteUrl } from '../config/site';
import { LAST_REVIEWED } from '../config/content';

export interface Props {
  cluster: ClusterDef;
}

const { cluster } = Astro.props;
const path = `/${cluster.base}`;

// Group the spokes for display. Clusters with no groupOrder render flat.
const grouped =
  cluster.groupOrder.length > 0
    ? cluster.groupOrder
        .map((g) => ({ group: g, items: cluster.spokes.filter((s) => s.group === g) }))
        .filter((g) => g.items.length > 0)
    : [{ group: '', items: cluster.spokes }];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: cluster.hubTitle,
  description: cluster.hubMetaDescription,
  url: absoluteUrl(path),
  inLanguage: 'en-SG',
  dateModified: LAST_REVIEWED,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cluster.spokes.length,
    itemListElement: cluster.spokes.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.label,
      url: absoluteUrl(`${path}/${s.slug}`),
    })),
  },
};

const otherClusters = clusters
  .filter((c) => c.base !== cluster.base)
  .map((c) => ({ href: `/${c.base}`, label: c.hubTitle, summary: c.blurb, kind: 'Hub' }));
---

<BaseLayout
  title={cluster.hubMetaTitle}
  description={cluster.hubMetaDescription}
  path={path}
  modified={LAST_REVIEWED}
  jsonLd={[itemListSchema]}
>
  <Breadcrumbs items={[{ label: cluster.label, href: path }]} />

  <section class="page-hero">
    <div class="container hero__content">
      <div class="eyebrow">{cluster.label}</div>
      <h1>{cluster.hubH1}</h1>
      <p class="lede">{cluster.hubLede}</p>
      <div class="hero__meta">
        <span class="hero__meta-item">{cluster.spokes.length} pages in this section</span>
      </div>
    </div>
  </section>

  {
    grouped.map((g, i) => (
      <section
        class={`section section--border-top${i % 2 === 1 ? ' section--subtle' : ''}`}
        aria-labelledby={g.group ? `group-${i}` : undefined}
      >
        <div class="container stack">
          {g.group && <h2 id={`group-${i}`}>{g.group}</h2>}
          <div class="grid grid--3">
            {g.items.map((s) => (
              <a class="service-card" href={withBase(`${path}/${s.slug}`)}>
                <h3>{s.label}</h3>
                <p>{s.summary}</p>
                <div class="service-card__link">Read more →</div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <LinkGrid
    links={otherClusters}
    heading="Other sections"
    eyebrow="Explore further"
    subtle
    id="other-clusters"
  />
</BaseLayout>
