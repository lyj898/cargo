---
// Shared layout for every programmatic spoke page (guides, permits, cargo,
// origin countries, exhibition venues). One layout keeps the schema, the
// internal-link mesh, and the CTA placement identical across ~100 pages, so
// improving any of them improves all of them at once.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQSection from '../components/FAQSection.astro';
import FactTable from '../components/FactTable.astro';
import KeyPoints from '../components/KeyPoints.astro';
import LinkGrid from '../components/LinkGrid.astro';
import OnThisPage from '../components/OnThisPage.astro';
import ProseSections from '../components/ProseSections.astro';
import { resolveLinks, siblingCards, getCluster } from '../data/clusters';
import type { SpokeBase } from '../data/types';
import { site, absoluteUrl } from '../config/site';
import { LAST_REVIEWED } from '../config/content';

export interface Props {
  base: string;
  spoke: SpokeBase;
  /** Optional callout above the body — used for guide "short version" boxes. */
  keyPoints?: string[];
  /** Extra schema objects appended to the page. */
  jsonLd?: Record<string, unknown>[];
  whatsappMessage?: string;
  factsCaption?: string;
}

const { base, spoke, keyPoints = [], jsonLd = [], whatsappMessage, factsCaption } = Astro.props;

const cluster = getCluster(base);
const path = `/${base}/${spoke.slug}`;

const siblings = siblingCards(base, spoke.slug, 6);
const related = resolveLinks(
  [...(spoke.relatedPaths ?? []), ...(spoke.relatedServices ?? []).map((s) => `/${s}`)],
  6,
);

// Article schema: these pages are editorial explainers, and marking them as
// such (rather than leaving them as bare WebPages) is what lets them show up
// with a byline and modified date in results that support it.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: spoke.h1,
  description: spoke.metaDescription,
  url: absoluteUrl(path),
  mainEntityOfPage: { '@type': 'WebPage', '@id': absoluteUrl(path) },
  inLanguage: 'en-SG',
  dateModified: LAST_REVIEWED,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  about: { '@type': 'Thing', name: spoke.label },
  isPartOf: {
    '@type': 'CollectionPage',
    name: cluster?.hubTitle ?? base,
    url: absoluteUrl(`/${base}`),
  },
};

const headings = spoke.sections.map((s) => s.heading);
---

<BaseLayout
  title={spoke.metaTitle}
  description={spoke.metaDescription}
  path={path}
  ogType="article"
  modified={LAST_REVIEWED}
  jsonLd={[articleSchema, ...jsonLd]}
>
  <Breadcrumbs
    items={[
      { label: cluster?.label ?? base, href: `/${base}` },
      { label: spoke.label, href: path },
    ]}
  />

  <section class="page-hero">
    <div class="container hero__content">
      <div class="eyebrow">{cluster?.label ?? base}</div>
      <h1>{spoke.h1}</h1>
      <p class="lede">{spoke.lede}</p>
    </div>
  </section>

  <OnThisPage headings={headings} />

  <KeyPoints points={keyPoints} />

  <FactTable facts={spoke.facts} caption={factsCaption ?? 'Key facts'} />

  <ProseSections sections={spoke.sections} />

  <slot />

  <FAQSection faqs={spoke.faqs} heading="Questions we get asked about this" id="faq" />

  <LinkGrid
    links={siblings}
    heading={`More in ${cluster?.hubTitle ?? base}`}
    eyebrow="Keep reading"
    subtle
    id="siblings"
  />

  <LinkGrid
    links={related}
    heading="Related pages"
    eyebrow="Elsewhere on the site"
    showKind
    id="related"
  />
</BaseLayout>
